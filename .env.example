# fal (server only)
FAL_KEY=

# Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App settings
KRISHNA_VOICE=orion
DAILY_MINUTES_LIMIT=30        # per person (account), per day
GLOBAL_DAILY_MINUTES=180      # everyone together, per day: this bounds the fal bill

# Optional: lets people sign in with a username instead of an email (username@this domain; never shown)
NEXT_PUBLIC_USERNAME_DOMAIN=
